<idea-plugin>
  <id>com.sdwvit.s2cfg</id>
  <name>STALKER 2 Cfg Support</name>
  <vendor email="vit.musienko@gmail.com">sdwvit</vendor>

  <description><![CDATA[
    Language support for STALKER 2 game data <code>.cfg</code> files: syntax highlighting,
    struct folding, structure view with <code>refkey</code> inheritance hints, brace matching
    and commenting. Ctrl-click navigation between records: <code>SID</code> references,
    <code>refkey</code> inheritance and <code>refurl</code> file paths all resolve, with find
    usages and rename.
    <br/>
    Mod SDK <code>*-localization.uasset</code> packages open as JSON — edit the SIDs and their
    per-language strings, and saving writes them back into the binary package.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="STALKER 2 Cfg" implementationClass="com.sdwvit.s2cfg.S2CfgFileType"
              fieldName="INSTANCE" language="S2Cfg" extensions="cfg"/>
    <lang.parserDefinition language="S2Cfg" implementationClass="com.sdwvit.s2cfg.S2CfgParserDefinition"/>
    <lang.syntaxHighlighterFactory language="S2Cfg"
                                   implementationClass="com.sdwvit.s2cfg.S2CfgSyntaxHighlighterFactory"/>
    <colorSettingsPage implementation="com.sdwvit.s2cfg.S2CfgColorSettingsPage"/>
    <lang.foldingBuilder language="S2Cfg" implementationClass="com.sdwvit.s2cfg.S2CfgFoldingBuilder"/>
    <lang.psiStructureViewFactory language="S2Cfg"
                                  implementationClass="com.sdwvit.s2cfg.S2CfgStructureViewFactory"/>
    <lang.braceMatcher language="S2Cfg" implementationClass="com.sdwvit.s2cfg.S2CfgBraceMatcher"/>
    <lang.commenter language="S2Cfg" implementationClass="com.sdwvit.s2cfg.S2CfgCommenter"/>

    <!-- stage 2: SID index and navigation -->
    <fileBasedIndex implementation="com.sdwvit.s2cfg.S2CfgSidIndex"/>
    <gotoSymbolContributor implementation="com.sdwvit.s2cfg.S2CfgGotoSymbolContributor"/>
    <lang.findUsagesProvider language="S2Cfg"
                             implementationClass="com.sdwvit.s2cfg.S2CfgFindUsagesProvider"/>
    <lang.elementManipulator forClass="com.sdwvit.s2cfg.S2CfgValue"
                             implementationClass="com.sdwvit.s2cfg.S2CfgValueManipulator"/>
    <lang.elementManipulator forClass="com.sdwvit.s2cfg.S2CfgRef"
                             implementationClass="com.sdwvit.s2cfg.S2CfgRefManipulator"/>

    <!-- stage 3: completion and inspections -->
    <fileBasedIndex implementation="com.sdwvit.s2cfg.S2CfgEnumIndex"/>
    <completion.contributor language="S2Cfg"
                            implementationClass="com.sdwvit.s2cfg.S2CfgCompletionContributor"/>
    <localInspection language="S2Cfg" shortName="S2CfgMissingRefurl"
                     displayName="Unresolved refurl path" groupName="STALKER 2 Cfg"
                     enabledByDefault="true" level="WARNING"
                     implementationClass="com.sdwvit.s2cfg.S2CfgMissingRefurlInspection"/>
    <localInspection language="S2Cfg" shortName="S2CfgDuplicateKey"
                     displayName="Duplicate key in struct" groupName="STALKER 2 Cfg"
                     enabledByDefault="true" level="WARNING"
                     implementationClass="com.sdwvit.s2cfg.S2CfgDuplicateKeyInspection"/>
    <localInspection language="S2Cfg" shortName="S2CfgUnresolvedSid"
                     displayName="Unresolved record reference" groupName="STALKER 2 Cfg"
                     enabledByDefault="false" level="WARNING"
                     implementationClass="com.sdwvit.s2cfg.S2CfgUnresolvedSidInspection"/>

    <!-- stage 5: *-localization.uasset packages, edited as JSON -->
    <fileType name="STALKER 2 Asset" implementationClass="com.sdwvit.s2cfg.S2UassetFileType"
              fieldName="INSTANCE" extensions="uasset"/>
    <fileEditorProvider implementation="com.sdwvit.s2cfg.S2LocalizationEditorProvider"/>

    <!-- stage 4: repo-aware extras -->
    <gotoRelatedProvider implementation="com.sdwvit.s2cfg.S2CfgRelatedProvider"/>
    <lang.documentationProvider language="S2Cfg"
                                implementationClass="com.sdwvit.s2cfg.S2CfgDocumentationProvider"/>
  </extensions>

  <applicationListeners>
    <!-- The localization editor's document is in-memory, so it has to be written through on save. -->
    <listener class="com.sdwvit.s2cfg.S2LocalizationSaveListener"
              topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
  </applicationListeners>
</idea-plugin>
